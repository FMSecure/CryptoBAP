theory XORexample
begin

builtins: symmetric-encryption
functions: Imm64/1

process:
  new ~v3_k;
  let v2_Key = ~v3_k in
  let v9_R0 = Imm64('0') in
  let v23_Enc = senc(v22_msg,v2_Key) in
  out('Channel',v23_Enc);
  let v35_R0 = Imm64('57920') in
  let v36_R0 = Imm64('0x1E240') in
  out('Channel',v45_R0);
  0

end
